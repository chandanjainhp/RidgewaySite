# ════════════════════════════════════════════════════════════════
# Application Settings
# ════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=8000
APP_NAME=Sentinel
APP_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# ════════════════════════════════════════════════════════════════
# Database Configuration
# ════════════════════════════════════════════════════════════════

# MongoDB - Docker container (localhost)
# NOTE: @ in password is URL-encoded as %40
MONGODB_URL=mongodb://admin:StrongMongoPass%40123@localhost:27017/ridgeway?authSource=admin

# Redis - Docker container (localhost)
# NOTE: @ in password is URL-encoded as %40
REDIS_URL=redis://:StrongRedisPass%40123@localhost:6379

# ════════════════════════════════════════════════════════════════
# JWT & Authentication
# ════════════════════════════════════════════════════════════════
ACCESS_TOKEN_SECRET="9UsoMwaYng98kRB4xst2olt7W4tSouDUaTiw9ipZiH7"
REFRESH_TOKEN_SECRET="v9F#sK8Lx2Qp@7ZrT5uY!cW3mN0eH6aB"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Admin-only gate for settings/environment configuration.
# ADMIN_PASSWORD may be plaintext in local .env or a bcrypt hash ($2a$/$2b$/$2y$).
ADMIN_PASSWORD=""
ADMIN_GATE_TOKEN_SECRET=""
ADMIN_GATE_TTL_SECONDS=900

# ════════════════════════════════════════════════════════════════
# AI Configuration - OpenRouter (for testing)
# ════════════════════════════════════════════════════════════════

# Option 1: OpenRouter API (Recommended for testing)
# Get your API key from: https://openrouter.ai
OPENROUTER_API_KEY=""
# Use OpenRouter host/root when using the Anthropic SDK.
# The SDK appends /v1/messages automatically.
OPENROUTER_BASE_URL="https://openrouter.ai"

# Option 2: Anthropic Claude (Comment out OpenRouter to use this)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ════════════════════════════════════════════════════════════════
# File Upload & Storage
# ════════════════════════════════════════════════════════════════

FILE_UPLOAD_PATH=./public/uploads
MAX_FILE_SIZE=10485760

# Cloudinary (Optional - for avatar uploads)
# Get credentials from: https://cloudinary.com
CLOUDINARY_CLOUD_NAME="dn4taxt25"
CLOUDINARY_API_KEY="266354267351167"
CLOUDINARY_API_SECRET=""

# ════════════════════════════════════════════════════════════════
# Email Configuration
# ════════════════════════════════════════════════════════════════

# Gmail SMTP Configuration
# Get app password from: https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="xgkz tknw mpfr byky"
EMAIL_FROM_NAME="Sentinel"
EMAIL_FROM_EMAIL="noreply@ridgeway-site.com"

# ════════════════════════════════════════════════════════════════
# OpenAI (embeddings only — text-embedding-3-small)
# ════════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-...

# ════════════════════════════════════════════════════════════════
# Qdrant Vector Database
# Use http://localhost:6333 when running outside Docker
# Use http://qdrant:6333 when running inside Docker Compose
# ════════════════════════════════════════════════════════════════
QDRANT_URL=http://localhost:6333

# ════════════════════════════════════════════════════════════════
# Sentry Error Monitoring
# ════════════════════════════════════════════════════════════════

# Get DSN from https://sentry.io — leave empty to disable Sentry entirely
SENTRY_DSN=

# ════════════════════════════════════════════════════════════════
# Logging
# ════════════════════════════════════════════════════════════════

LOG_LEVEL=info

# ════════════════════════════════════════════════════════════════
# Security
# ════════════════════════════════════════════════════════════════

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# ════════════════════════════════════════════════════════════════
# Optional Settings
# ════════════════════════════════════════════════════════════════

DEBUG=true

# Optional: File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads
