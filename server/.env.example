# App
NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Databases — match server/docker-compose.local.yml (docker compose -f docker-compose.dev.yml)
MONGODB_URL=mongodb://admin:StrongMongoPass%40123@localhost:27017/ridgeway?authSource=admin
REDIS_URL=redis://:StrongRedisPass%40123@localhost:6379
# QDRANT_URL=http://localhost:6333

# Auth
ACCESS_TOKEN_SECRET=change-me-64-char-random-string-for-access-tokens-here-now
REFRESH_TOKEN_SECRET=change-me-64-char-random-string-for-refresh-tokens-here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Drone event ingestion — optional override for bootstrap-admin.js (otherwise auto-generated)
# INGESTION_SECRET=

# Bootstrap (bootstrap-admin.js only)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme
# WIPE_ALL=true
# SITE_NAME=Sentinel Site

# LLM — prod
# ANTHROPIC_API_KEY=sk-ant-...

# LLM — local dev (LM Studio)
# USE_LOCAL_LLM=true
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio
# LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# Webhooks
WEBHOOK_SECRET=change-me-64-char-random-string-for-webhook-hmac-signing

# Email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=app-password
# EMAIL_FROM_NAME=Sentinel
# EMAIL_FROM_ADDRESS=noreply@sentinel.io

# --- Raspberry Pi / Cloudflare Tunnel (root docker-compose.yml) ---
# Prefer the root `.env.example` next to docker-compose.yml for Pi deploys.
# CLOUDFLARE_TUNNEL_TOKEN comes from: Cloudflare Zero Trust → Networks → Tunnels
# → create tunnel → copy token. Map public hostname → http://client:3000 (Compose
# service name). No separate API hostname needed — Next proxies /api/v1 internally.
# CLOUDFLARE_TUNNEL_TOKEN=
