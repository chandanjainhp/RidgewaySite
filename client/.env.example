# Environment Variables - Client

# Local dev: point at the API on the host. Browser axios still uses same-origin
# /api/v1 (Next rewrites); this value is mainly for SSR / rewrite fallback.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pi / Cloudflare compose: leave NEXT_PUBLIC_API_URL unset in the client
# container. Set API_UPSTREAM_URL=http://server:8000 (compose already does)
# so rewrites stay on the Docker network and the public hostname stays single.

NEXT_PUBLIC_SUPPORT_EMAIL=support@sentinel.io
