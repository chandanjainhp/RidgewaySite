# Sentinel — Raspberry Pi / Cloudflare Tunnel production env
# Copy to .env next to docker-compose.yml and fill in every value marked CHANGE-ME.
#
# IMPORTANT: Docker Compose treats $word in .env as variable interpolation.
# If a password/token contains $, write $$ instead (e.g. pa$$word → password value pa$word).
# WARN "The \"zR1\" variable is not set" means an unescaped $zR1 in a secret — fix with $$.

# --- Cloudflare Tunnel ---
# Zero Trust dashboard → Networks → Tunnels → Create a tunnel (cloudflared) → copy token.
# Public hostname mapping (in the same tunnel config UI):
#   Hostname:  yourdomain.com   (or app.yourdomain.com)
#   Service:   http://client:3000
# Use the Docker Compose service name "client", not localhost — cloudflared is on the
# same bridge network. Single hostname is enough: the Next.js client proxies /api/v1
# to http://server:8000 inside the network (no separate api.* route required).
CLOUDFLARE_TUNNEL_TOKEN=CHANGE-ME-paste-tunnel-token-here

# Public URL users open in the browser (must match the Cloudflare hostname, https)
CLIENT_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# --- MongoDB ---
MONGO_ROOT_USER=sentinel
MONGO_ROOT_PASSWORD=CHANGE-ME-strong-mongo-password
MONGO_DB=sentinel

# --- Redis ---
REDIS_PASSWORD=CHANGE-ME-strong-redis-password

# --- Auth (generate long random strings, e.g. openssl rand -hex 32) ---
ACCESS_TOKEN_SECRET=CHANGE-ME-64-char-random-string-for-access-tokens
REFRESH_TOKEN_SECRET=CHANGE-ME-64-char-random-string-for-refresh-tokens
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- Webhooks ---
WEBHOOK_SECRET=CHANGE-ME-64-char-random-string-for-webhook-hmac

# --- LLM (production: Anthropic; leave USE_LOCAL_LLM unset/false on the Pi) ---
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME
# USE_LOCAL_LLM=false

# --- Email (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM_NAME=Sentinel
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# --- Optional: Qdrant if you run it elsewhere (not in this compose by default) ---
# QDRANT_URL=http://qdrant:6333
