# =============================================================================
# server/.env.example  →  copy to server/.env
# Only env file the API / Pi compose stack needs.
# Client UI vars live in client/.env.example (separate).
#
# Compose treats $word as interpolation. Prefer secrets with no $:
#   openssl rand -hex 32
# If a value must contain $, write $$ for each literal $.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Databases (local: docker compose -f docker-compose.dev.yml) ---
# Match server/docker-compose.local.yml credentials:
MONGODB_URL=mongodb://admin:StrongMongoPass%40123@localhost:27017/ridgeway?authSource=admin
REDIS_URL=redis://:StrongRedisPass%40123@localhost:6379
# QDRANT_URL=http://localhost:6333

# --- Auth ---
ACCESS_TOKEN_SECRET=change-me-use-openssl-rand-hex-32
REFRESH_TOKEN_SECRET=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- Drone ingestion / bootstrap-admin.js (optional) ---
# INGESTION_SECRET=
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme-at-least-8
# WIPE_ALL=true
# SITE_NAME=Sentinel Site

# --- LLM: anthropic | local | mistral ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# LLM_PROVIDER=local
# USE_LOCAL_LLM=true
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio
# LOCAL_LLM_MODEL=qwen2.5-7b-instruct
#
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=   # https://console.mistral.ai/api-keys
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-large-latest
# (model names: https://docs.mistral.ai/getting-started/models/)

# --- Webhooks / email ---
WEBHOOK_SECRET=change-me-use-openssl-rand-hex-32
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM_NAME=Sentinel
# EMAIL_FROM_ADDRESS=noreply@sentinel.io

# =============================================================================
# Pi / production (root docker-compose.yml)
#   docker compose --env-file server/.env up -d
# On Pi: set CLIENT_URL + CORS_ORIGIN to your public https URL (not localhost).
# Tunnel dashboard service URL: http://client:3000
# =============================================================================

# Required for Pi compose (openssl rand -hex 24 — no $ characters)
MONGO_ROOT_USER=sentinel
MONGO_ROOT_PASSWORD=CHANGE-ME-run-openssl-rand-hex-24
MONGO_DB=sentinel
REDIS_PASSWORD=CHANGE-ME-run-openssl-rand-hex-24

CLOUDFLARE_TUNNEL_TOKEN=CHANGE-ME-paste-tunnel-token
